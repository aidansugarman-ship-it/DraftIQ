rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A real (non-anonymous) signed-in account. Anonymous sessions exist only
    // so pre-signup screens can reach the AI proxy — they must never be able
    // to create profiles or own documents.
    function isRealUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if isRealUser() && request.auth.uid == userId;
    }

    // AI call counters — written by the aiProxy Cloud Function via the Admin
    // SDK only (Admin bypasses these rules). No client access, ever: a client
    // that could write here could reset its own rate limit.
    match /aiUsage/{docId} {
      allow read, write: if false;
    }

    // Players are public read, admin-only write
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Articles are public read, admin-only write
    match /articles/{articleId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Injuries are public read, admin-only write
    match /injuries/{injuryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Mock drafts: users own their own
    match /mockDrafts/{draftId} {
      allow read, write: if isRealUser() && request.auth.uid == resource.data.userId;
      allow create: if isRealUser() && request.auth.uid == request.resource.data.userId;
    }

    // Trades: users own their own
    match /trades/{tradeId} {
      allow read, write: if isRealUser() && request.auth.uid == resource.data.userId;
      allow create: if isRealUser() && request.auth.uid == request.resource.data.userId;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
